# Copy privately only when .env does not already exist. Never commit credentials.
# Active model configuration: the current UI uses this reviewed model.
NEBIUS_API_KEY=
LLM_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507

# Documentary default: VECTOR_STORE is read from the process environment, not .env.
# Streamlit selects its backend explicitly.
VECTOR_STORE=chroma

# Optional Pinecone. Leave unused credentials empty.
# Match name/cloud/region to the separately reviewed .local/pinecone/target.json.
# Index-bound owner confirmation and local publication metadata are also required;
# these placeholders do not confirm an account, provision or select resources.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
PINECONE_CLOUD=azure
PINECONE_REGION=eastus2

# Reserved/documentary settings, not runtime overrides in the current implementation.
# MiniLM and the Chroma persistence path are fixed by the application.
APP_ENV=development
LOG_LEVEL=INFO
CHROMA_PERSIST_DIR=.local/chroma
FIREWORKS_API_KEY=
EMBEDDING_MODEL=

# UI live/Pinecone gates are process environment variables, not loaded from .env.
# See README before enabling them; both are disabled by default.
# NORTHSTAR_PROJECT_ROOT is also process-only operator configuration, not a .env
# or chat override. Without it the application validates its source checkout.
